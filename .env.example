# Application
APP_NAME="SME CyberShield API"
ENVIRONMENT=local

# Database
# For Docker:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/sme_cybershield

# For local development without Docker:
# DATABASE_URL=sqlite:///./sme_cybershield.db

# Response mode
# dry_run = log recommended actions but do not execute
# manual = require human approval
# auto = execute safe automated actions
RESPONSE_MODE=dry_run

# ML
ANOMALY_THRESHOLD=0.65

# Wazuh
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# Localization
TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_LANGUAGE=vi